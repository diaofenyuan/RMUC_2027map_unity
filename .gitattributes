# 大体积二进制资产通过 Git LFS 存储（GitHub 对普通文件有 100 MB 单文件上限）
*.fbx filter=lfs diff=lfs merge=lfs -text
*.ply filter=lfs diff=lfs merge=lfs -text

# Unity 的 YAML 资产与代码统一 LF，避免跨平台产生无意义差异
*.unity      text eol=lf
*.prefab     text eol=lf
*.asset      text eol=lf
*.meta       text eol=lf
*.json       text eol=lf
*.md         text eol=lf
*.cs         text eol=lf
*.cs         diff=csharp

# 启动脚本必须保持 CRLF，否则部分 Windows 环境的标签跳转会失效
*.bat        text eol=crlf
*.bat        -diff
